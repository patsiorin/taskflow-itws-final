{
  "name": "taskflow-clean-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Layered ITWS final project monorepo for a Kanban todo app.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
    "frontend:dev": "npm run dev -w @taskflow/frontend",
    "frontend:build": "npm run build -w @taskflow/frontend",
    "backend:dev": "npm run start:dev -w @taskflow/backend",
    "backend:build": "npm run build -w @taskflow/backend",
    "prisma:generate": "npm run prisma:generate -w @taskflow/backend",
    "prisma:migrate": "npm run prisma:migrate -w @taskflow/backend",
    "build": "npm run backend:build && npm run frontend:build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}

